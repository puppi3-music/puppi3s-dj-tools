–””–””––””––””––”––””––””––””–””––””––””––”––””––””––”––””––””––”––””––””––”––””––””––”––””––””––”––””––””––”––””––””––”––””––”––””––””––”––””––””––”––””––”––””––””––”––””––”–––”––””––”––””––”––””––””––”––””––”––””––”–––”––””––”––””––”––””––”––””––”–––”––””––”––””––”––””––”––””––”––””––”–––”––”–––”––”–––”––”–––”––”–––”––”–––”––”–––”––”–––”––”–––”––”–––”––”–––”––”––””––”––””––”––””––”––””––”––”–––”––”–––”––”––””––”––””––”––”–––”––”–––”––”––””––”––”–––”––”––””––”––”–––”––”–––”––”––”–––”––”–––”––”––”–––