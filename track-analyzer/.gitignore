# Python environment (recreated with `uv sync`)
.venv/
__pycache__/
*.pyc

# Output you saved from runs (keep it in logs/)
logs/*
!logs/.gitkeep
*.txt
*.csv
*.log

# macOS
.DS_Store

# Personal Claude context and notes (see CLAUDE.md)
CLAUDE.local.md
*.local.md
*.local.html

# Databases, models, caches and backups (TRACK_ANALYZER_HOME default)
data/

# Docker data (compose.yaml, TRACK_ANALYZER_DATA default)
data-docker/
